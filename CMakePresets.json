{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "PATH": "$env{QT_ROOT}/bin${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "KLOGG_BUILD_TESTS": false,
        "KLOGG_BUILD_UI_TESTS": true,
        "KLOGG_USE_LTO": false,
        "KLOGG_USE_HYPERSCAN": false,
        "KLOGG_USE_VECTORSCAN": false,
        "FETCHCONTENT_QUIET": false
      }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux / GCC / Debug",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux / GCC / Release",
      "inherits": "linux-gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows / MSVC / Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows / MSVC / Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-clang-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "KLOGG_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "macos-clang-debug",
      "displayName": "Darwin / CLANG / Debug",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-clang-release",
      "displayName": "Darwin / CLANG / Release",
      "inherits": "macos-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true,
      "targets": [
        "ci_build"
      ]
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "build-base",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "build-base",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "build-base",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "inherits": "build-base",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "macos-clang-debug",
      "inherits": "build-base",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-release",
      "inherits": "build-base",
      "configurePreset": "macos-clang-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "linux-gcc-debug",
      "inherits": "test-base",
      "configurePreset": "linux-gcc-debug"
    },
    {
      "name": "linux-gcc-release",
      "inherits": "test-base",
      "configurePreset": "linux-gcc-release"
    },
    {
      "name": "windows-msvc-debug",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-release",
      "inherits": "test-base",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "macos-clang-debug",
      "inherits": "test-base",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-release",
      "inherits": "test-base",
      "configurePreset": "macos-clang-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "linux-gcc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-debug"
        },
        {
          "type": "build",
          "name": "linux-gcc-debug"
        },
        {
          "type": "test",
          "name": "linux-gcc-debug"
        }
      ]
    },
    {
      "name": "linux-gcc-release",
      "steps": [
        {
          "type": "configure",
          "name": "linux-gcc-release"
        },
        {
          "type": "build",
          "name": "linux-gcc-release"
        },
        {
          "type": "test",
          "name": "linux-gcc-release"
        }
      ]
    },
    {
      "name": "windows-msvc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-debug"
        },
        {
          "type": "build",
          "name": "windows-msvc-debug"
        },
        {
          "type": "test",
          "name": "windows-msvc-debug"
        }
      ]
    },
    {
      "name": "windows-msvc-release",
      "steps": [
        {
          "type": "configure",
          "name": "windows-msvc-release"
        },
        {
          "type": "build",
          "name": "windows-msvc-release"
        },
        {
          "type": "test",
          "name": "windows-msvc-release"
        }
      ]
    },
    {
      "name": "macos-clang-debug",
      "steps": [
        {
          "type": "configure",
          "name": "macos-clang-debug"
        },
        {
          "type": "build",
          "name": "macos-clang-debug"
        },
        {
          "type": "test",
          "name": "macos-clang-debug"
        }
      ]
    },
    {
      "name": "macos-clang-release",
      "steps": [
        {
          "type": "configure",
          "name": "macos-clang-release"
        },
        {
          "type": "build",
          "name": "macos-clang-release"
        },
        {
          "type": "test",
          "name": "macos-clang-release"
        }
      ]
    }
  ]
}
