{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "KLOGG_BUILD_TESTS": false,
        "KLOGG_USE_LTO": false
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "ninja-ui-base",
      "hidden": true,
      "inherits": "ninja-base",
      "binaryDir": "${sourceDir}/out/ui-ninja/${presetName}",
      "cacheVariables": {
        "KLOGG_BUILD_UI_TESTS": true,
        "KLOGG_BUILD_TESTS": false,
        "KLOGG_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja Debug",
      "description": "跨平台 Debug 构建；Windows 需在 MSVC 开发者环境中运行",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja Release",
      "description": "跨平台 Release 构建（启用 LTO）；Windows 需在 MSVC 开发者环境中运行",
      "inherits": "ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KLOGG_USE_LTO": true
      }
    },
    {
      "name": "ninja-ui-debug",
      "displayName": "Ninja UI Debug",
      "description": "Debug 构建并启用 UI 专项测试",
      "inherits": "ninja-ui-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-ui-release",
      "displayName": "Ninja UI Release",
      "description": "Release 构建（启用 LTO）并启用 UI 专项测试；发布验收入口",
      "inherits": "ninja-ui-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KLOGG_USE_LTO": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release"
    },
    {
      "name": "ninja-ui-debug",
      "configurePreset": "ninja-ui-debug"
    },
    {
      "name": "ninja-ui-release",
      "configurePreset": "ninja-ui-release"
    }
  ],
  "testPresets": [
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-ui-debug",
      "configurePreset": "ninja-ui-debug",
      "filter": {
        "include": {
          "name": "^zzlogg_ui\\."
        }
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ninja-ui-release",
      "configurePreset": "ninja-ui-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "ninja-debug",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-debug"
        },
        {
          "type": "build",
          "name": "ninja-debug"
        },
        {
          "type": "test",
          "name": "ninja-debug"
        }
      ]
    },
    {
      "name": "ninja-release",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-release"
        },
        {
          "type": "build",
          "name": "ninja-release"
        },
        {
          "type": "test",
          "name": "ninja-release"
        }
      ]
    },
    {
      "name": "ninja-ui-debug",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-ui-debug"
        },
        {
          "type": "build",
          "name": "ninja-ui-debug"
        },
        {
          "type": "test",
          "name": "ninja-ui-debug"
        }
      ]
    },
    {
      "name": "ninja-ui-release",
      "steps": [
        {
          "type": "configure",
          "name": "ninja-ui-release"
        },
        {
          "type": "build",
          "name": "ninja-ui-release"
        },
        {
          "type": "test",
          "name": "ninja-ui-release"
        }
      ]
    }
  ]
}
