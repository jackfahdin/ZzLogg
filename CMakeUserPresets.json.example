{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-machine",
      "hidden": true,
      "description": "只在这里填写本机 Qt kit 路径（含 msvc2022_64 等子目录）；Windows 请使用 MSVC x64 开发者环境。",
      "environment": {
        "QT_ROOT": "D:/SoftWare/Qt/6.12.0/msvc2022_64"
      }
    },
    {
      "name": "local-windows-debug",
      "inherits": [
        "local-machine",
        "windows-msvc-debug"
      ]
    },
    {
      "name": "local-windows-release",
      "inherits": [
        "local-machine",
        "windows-msvc-release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "local-windows-debug",
      "inherits": "windows-msvc-debug",
      "configurePreset": "local-windows-debug"
    },
    {
      "name": "local-windows-release",
      "inherits": "windows-msvc-release",
      "configurePreset": "local-windows-release"
    },
    {
      "name": "local-windows-runtime",
      "inherits": "local-windows-release",
      "targets": [
        "zzlogg_runtime_folder"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "local-windows-debug",
      "inherits": "windows-msvc-debug",
      "configurePreset": "local-windows-debug"
    },
    {
      "name": "local-windows-release",
      "inherits": "windows-msvc-release",
      "configurePreset": "local-windows-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "local-windows-debug",
      "steps": [
        {
          "type": "configure",
          "name": "local-windows-debug"
        },
        {
          "type": "build",
          "name": "local-windows-debug"
        },
        {
          "type": "test",
          "name": "local-windows-debug"
        }
      ]
    },
    {
      "name": "local-windows-release",
      "steps": [
        {
          "type": "configure",
          "name": "local-windows-release"
        },
        {
          "type": "build",
          "name": "local-windows-release"
        },
        {
          "type": "test",
          "name": "local-windows-release"
        }
      ]
    },
    {
      "name": "local-windows-runtime",
      "steps": [
        {
          "type": "configure",
          "name": "local-windows-release"
        },
        {
          "type": "build",
          "name": "local-windows-runtime"
        }
      ]
    }
  ]
}
