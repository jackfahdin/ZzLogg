{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-qt6",
      "displayName": "Windows Qt 6",
      "inherits": "windows-vs2026",
      "binaryDir": "${sourceDir}/out/build/windows-qt6",
      "cacheVariables": {
        "CMAKE_GENERATOR_INSTANCE": "C:/Path/To/Microsoft Visual Studio/18/Community",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.x/msvc2022_64",
        "KLOGG_BUILD_UI_TESTS": true,
        "KLOGG_USE_HYPERSCAN": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-qt6-debug",
      "configurePreset": "windows-qt6",
      "configuration": "Debug"
    },
    {
      "name": "windows-qt6-release",
      "configurePreset": "windows-qt6",
      "configuration": "Release"
    },
    {
      "name": "windows-qt6-runtime",
      "configurePreset": "windows-qt6",
      "configuration": "Release",
      "targets": ["zzlogg_runtime_folder"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-qt6-debug",
      "configurePreset": "windows-qt6",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-qt6-release",
      "configurePreset": "windows-qt6",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "windows-qt6-debug",
      "steps": [
        { "type": "configure", "name": "windows-qt6" },
        { "type": "build", "name": "windows-qt6-debug" },
        { "type": "test", "name": "windows-qt6-debug" }
      ]
    },
    {
      "name": "windows-qt6-runtime",
      "steps": [
        { "type": "configure", "name": "windows-qt6" },
        { "type": "build", "name": "windows-qt6-runtime" }
      ]
    }
  ]
}
