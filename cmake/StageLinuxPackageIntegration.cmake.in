if(NOT "$ENV{DESTDIR}" STREQUAL "")
  # DEB/RPM keep CMAKE_INSTALL_PREFIX at /opt/ZzLogg and supply the
  # staging root separately. file(WRITE) does not prepend DESTDIR for us.
  set(package_root "$ENV{DESTDIR}")
else()
  # Non-DESTDIR generators include the application prefix in the staged path.
  set(package_root "${CMAKE_INSTALL_PREFIX}")
  set(zz_packaging_prefix "@CPACK_PACKAGING_INSTALL_PREFIX@")
  if(NOT zz_packaging_prefix)
    set(zz_packaging_prefix "/opt/ZzLogg")
  endif()
  if(package_root MATCHES "${zz_packaging_prefix}$")
    string(REGEX REPLACE "${zz_packaging_prefix}$" "" package_root "${package_root}")
  endif()
endif()
cmake_path(NORMAL_PATH package_root)
if(NOT IS_ABSOLUTE "${package_root}" OR package_root STREQUAL "/")
  message(FATAL_ERROR "Refusing to stage Linux integration without a package root")
endif()
set(source_root "@PROJECT_SOURCE_DIR@")

file(MAKE_DIRECTORY "${package_root}/usr/bin")
file(WRITE "${package_root}/usr/bin/ZzLogg"
  "#!/bin/sh\nexec /opt/ZzLogg/bin/ZzLogg \"\$@\"\n")
file(CHMOD "${package_root}/usr/bin/ZzLogg"
  PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
              GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)

file(MAKE_DIRECTORY "${package_root}/usr/share/applications")
configure_file(
  "${source_root}/packaging/linux/ZzLogg.desktop"
  "${package_root}/usr/share/applications/ZzLogg.desktop"
  COPYONLY)

foreach(icon_size IN ITEMS 16 32 48 64 128 256 512)
  set(icon_dir
    "${package_root}/usr/share/icons/hicolor/${icon_size}x${icon_size}/apps")
  file(MAKE_DIRECTORY "${icon_dir}")
  configure_file(
    "${source_root}/src/app/images/hicolor/${icon_size}x${icon_size}/ZzLogg.png"
    "${icon_dir}/ZzLogg.png"
    COPYONLY)
endforeach()

set(scalable_dir
  "${package_root}/usr/share/icons/hicolor/scalable/apps")
file(MAKE_DIRECTORY "${scalable_dir}")
configure_file(
  "${source_root}/src/app/images/hicolor/scalable/ZzLogg.svg"
  "${scalable_dir}/ZzLogg.svg"
  COPYONLY)
