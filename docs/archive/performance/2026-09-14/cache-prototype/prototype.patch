diff --git a/tests/ui_acceptance/repaintprobe.h b/tests/ui_acceptance/repaintprobe.h
new file mode 100644
--- /dev/null
+++ b/tests/ui_acceptance/repaintprobe.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <QElapsedTimer>
+#include <QDebug>
+#include <array>
+
+// Temporary, GUI-thread-only diagnostic. Inclusive, nested wall-clock timings.
+namespace RepaintProbe {
+enum Part { Paint, Cache, Fetch, Text, Blit, Count };
+inline const void* target = nullptr;
+inline std::array<qint64, Count> ns{};
+inline std::array<qint64, Count> calls{};
+class Scope {
+    Part part_;
+    bool enabled_;
+    QElapsedTimer timer_;
+public:
+    Scope(Part part, const void* view) : part_(part), enabled_(target == view) {
+        if (enabled_) timer_.start();
+    }
+    ~Scope() {
+        if (enabled_) {
+            ns[part_] += timer_.nsecsElapsed();
+            ++calls[part_];
+        }
+    }
+};
+inline void begin(const void* view) {
+    ns.fill(0);
+    calls.fill(0);
+    target = qEnvironmentVariableIntValue("ZZLOGG_REPAINT_PROBE") == 1 ? view : nullptr;
+}
+inline void end() {
+    target = nullptr;
+    const char* names[] = {"paint", "cache", "fetch", "text", "blit"};
+    for (int i = 0; i < Count; ++i)
+        qInfo("Repaint detail: part=%s, ns=%lld, calls=%lld", names[i],
+              static_cast<long long>(ns[i]), static_cast<long long>(calls[i]));
+}
+}
