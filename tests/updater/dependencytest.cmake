if(NOT EXISTS "${DUMPBIN}" OR NOT EXISTS "${EXECUTABLE}")
  message(FATAL_ERROR "Native dependency inspection requires dumpbin and a built consumer")
endif()
# /IMPORTS inspects both the normal import table and delay-load import table
# in the actual linked image, not merely link command flags or PATH contents.
execute_process(COMMAND "${DUMPBIN}" /IMPORTS "${EXECUTABLE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE dependencies ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect real consumer: ${error}")
endif()
string(TOLOWER "${dependencies}" dependencies_lower)
if(dependencies_lower MATCHES "qt[56]|vcruntime|msvcp[0-9]|msvcr[0-9]|ucrtbase|api-ms-win-crt")
  message(FATAL_ERROR "Updater consumer imports forbidden Qt/dynamic CRT dependency: ${dependencies}")
endif()
if(DEFINED STATIC_LIBRARIES)
  foreach(library IN LISTS STATIC_LIBRARIES)
    execute_process(COMMAND "${DUMPBIN}" /DIRECTIVES "${library}"
      RESULT_VARIABLE result OUTPUT_VARIABLE directives ERROR_VARIABLE error)
    string(TOLOWER "${directives}" directives)
    if(NOT result EQUAL 0 OR directives MATCHES "defaultlib:[\"]?msvcrt")
      message(FATAL_ERROR "Dynamic CRT or unreadable static closure member ${library}: ${error}")
    endif()
    if(NOT directives MATCHES "defaultlib:[\"]?libcmt")
      message(FATAL_ERROR "Static CRT evidence missing for ${library}")
    endif()
  endforeach()
endif()
message(STATUS "Real updater consumer and all supplied closure archives are Qt-free and static CRT")
