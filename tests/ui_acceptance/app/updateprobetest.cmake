if(NOT DEFINED APP OR NOT DEFINED TEST_ROOT)
  message(FATAL_ERROR "APP and TEST_ROOT are required")
endif()
file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/config" "${TEST_ROOT}/data")
file(WRITE "${TEST_ROOT}/config/sentinel" "existing settings")
file(WRITE "${TEST_ROOT}/data/sentinel" "existing session")
set(ENV{XDG_CONFIG_HOME} "${TEST_ROOT}/config")
set(ENV{XDG_DATA_HOME} "${TEST_ROOT}/data")
set(ENV{APPDATA} "${TEST_ROOT}/config")
set(ENV{LOCALAPPDATA} "${TEST_ROOT}/data")
if(WIN32)
  set(ENV{QT_QPA_PLATFORM} "windows")
else()
  set(ENV{QT_QPA_PLATFORM} "offscreen")
endif()
execute_process(COMMAND "${APP}" --update-probe
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "0" OR NOT output MATCHES "ZZLOGG_UPDATE_PROBE_OK")
  message(FATAL_ERROR "Probe failed: ${result}; ${output}; ${error}")
endif()
execute_process(COMMAND "${APP}" --update-probe --data-dir "${TEST_ROOT}/data"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(NOT result STREQUAL "64" OR output MATCHES "ZZLOGG_UPDATE_PROBE_OK")
  message(FATAL_ERROR "Probe accepted live-data arguments: ${result}; ${output}; ${error}")
endif()
file(GLOB_RECURSE state RELATIVE "${TEST_ROOT}" "${TEST_ROOT}/*")
if(NOT state STREQUAL "config/sentinel;data/sentinel")
  message(FATAL_ERROR "Probe wrote to real user storage: ${state}")
endif()
file(READ "${TEST_ROOT}/config/sentinel" settings)
file(READ "${TEST_ROOT}/data/sentinel" session)
if(NOT settings STREQUAL "existing settings" OR NOT session STREQUAL "existing session")
  message(FATAL_ERROR "Probe modified existing user files")
endif()
