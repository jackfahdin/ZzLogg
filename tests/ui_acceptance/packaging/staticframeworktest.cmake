if(NOT EXISTS "${APP}" OR NOT EXISTS "${DUMPBIN}")
  message(FATAL_ERROR "APP and DUMPBIN must exist")
endif()
execute_process(COMMAND "${DUMPBIN}" /DEPENDENTS "${APP}"
  RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect executable imports: ${error}")
endif()
string(TOLOWER "${imports}" imports)
if(imports MATCHES "(zz[a-z0-9_]*|qwk[a-z0-9_]*)\\.dll")
  message(FATAL_ERROR "Executable still imports framework DLLs: ${CMAKE_MATCH_0}")
endif()
if(NOT imports MATCHES "qt6core[a-z]*\\.dll")
  message(FATAL_ERROR "Qt must remain dynamically linked")
endif()
if(NOT imports MATCHES "vcruntime[0-9_a-z]*\\.dll")
  message(FATAL_ERROR "MSVC runtime must remain dynamically linked")
endif()
