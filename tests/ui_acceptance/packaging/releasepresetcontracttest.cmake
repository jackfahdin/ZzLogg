if(NOT DEFINED SOURCE_ROOT)
  message(FATAL_ERROR "SOURCE_ROOT is required")
endif()
file(READ "${SOURCE_ROOT}/CMakePresets.json" presets)
function(find_preset section name output)
  string(JSON count LENGTH "${presets}" "${section}")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON candidate GET "${presets}" "${section}" ${index} name)
    if(candidate STREQUAL name)
      string(JSON preset GET "${presets}" "${section}" ${index})
      set(${output} "${preset}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "Missing ${section}: ${name}")
endfunction()

# 三个平台的 Release 工作流都必须完成配置、构建和完整测试。
find_preset(configurePresets base base)
string(JSON ui_tests GET "${base}" cacheVariables KLOGG_BUILD_UI_TESTS)
if(NOT ui_tests)
  message(FATAL_ERROR "Development presets must enable acceptance tests")
endif()
find_preset(buildPresets build-base build_base)
string(JSON target GET "${build_base}" targets 0)
if(NOT target STREQUAL "ci_build")
  message(FATAL_ERROR "Build presets must build the application and registered tests")
endif()
find_preset(testPresets test-base test_base)
string(JSON no_tests GET "${test_base}" execution noTestsAction)
if(NOT no_tests STREQUAL "error")
  message(FATAL_ERROR "Empty test suites must not silently succeed")
endif()
# 不允许在公共或平台测试预设中隐藏测试。
string(JSON test_count LENGTH "${presets}" testPresets)
math(EXPR test_last "${test_count} - 1")
foreach(index RANGE 0 ${test_last})
  string(JSON filter ERROR_VARIABLE filter_error GET "${presets}" testPresets ${index} filter)
  if(NOT filter_error)
    message(FATAL_ERROR "Acceptance presets must run the complete registered test suite")
  endif()
endforeach()

foreach(platform IN ITEMS linux-gcc windows-msvc macos-clang)
  set(release_preset "${platform}-release")
  find_preset(configurePresets ${release_preset} configure_entry)
  string(JSON build_type GET "${configure_entry}" cacheVariables CMAKE_BUILD_TYPE)
  if(NOT build_type STREQUAL "Release")
    message(FATAL_ERROR "${release_preset} must configure a Release build, got ${build_type}")
  endif()

  foreach(section IN ITEMS buildPresets testPresets)
    find_preset(${section} ${release_preset} entry)
    string(JSON configure GET "${entry}" configurePreset)
    if(NOT configure STREQUAL release_preset)
      message(FATAL_ERROR "${section} must use the ${release_preset} configure preset")
    endif()
  endforeach()

  find_preset(workflowPresets ${release_preset} workflow)
  set(expected_types configure build test)
  string(JSON count LENGTH "${workflow}" steps)
  if(NOT count EQUAL 3)
    message(FATAL_ERROR "Release workflow must configure, build and test")
  endif()
  foreach(index RANGE 0 2)
    string(JSON name GET "${workflow}" steps ${index} name)
    string(JSON type GET "${workflow}" steps ${index} type)
    list(GET expected_types ${index} expected_type)
    if(NOT name STREQUAL release_preset OR NOT type STREQUAL expected_type)
      message(FATAL_ERROR "Invalid ${release_preset} workflow step ${index}")
    endif()
  endforeach()
endforeach()
