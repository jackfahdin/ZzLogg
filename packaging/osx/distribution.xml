<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>ZzLogg log viewer</title>
    <license file="COPYING"/>
    <welcome file="description.txt"/>
    
    <pkg-ref id="com.gitcode.jackfahdinqt.zzlogg"/>
    <options customize="never" require-scripts="false"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.gitcode.jackfahdinqt.zzlogg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.gitcode.jackfahdinqt.zzlogg" visible="false">
        <pkg-ref id="com.gitcode.jackfahdinqt.zzlogg"/>
    </choice>
    <pkg-ref id="com.gitcode.jackfahdinqt.zzlogg" version="%zzlogg_version%" onConclusion="none">%zzlogg_pkg%</pkg-ref>
</installer-gui-script>
